# ==========================================================================
# BridgeTalk-specific
# ==========================================================================

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Secrets --------------------------------------------------------------
# .env is already ignored above. Kaggle credentials must never be committed.
kaggle.json
.kaggle/

# --- Datasets -------------------------------------------------------------
# Raw datasets are large (ASL Alphabet alone is ~1.1 GB) and are downloaded by
# every developer from Kaggle, so they never belong in git.
ml/data/raw/*
!ml/data/raw/.gitkeep

# Extracted landmark files are regenerable from the raw data via
# ml/scripts/extract_landmarks_images.py, so they are also ignored.
ml/data/processed/*
!ml/data/processed/.gitkeep

# Webcam clips recorded by record_eval_clip.py. EVALUATION ONLY — these are
# never read by preprocess.py or by either training script. Ignored both
# because they are regenerable and because self-recorded footage must never
# be mistaken for part of the training set.
ml/data/eval/

# --- Trained models -------------------------------------------------------
# Keras weights are binary and get regenerated by training. The small JSON
# side-cars ARE committed: they document what was trained and are what the
# backend checks its normalisation version against.
ml/models/*
!ml/models/.gitkeep
!ml/models/labels.json
!ml/models/metadata.json
!ml/models/dataset_manifest.json
!ml/models/training_history.json
!ml/models/evaluation_report.json
# Model B side-cars, on the same rule. dynamic_model.keras itself stays ignored.
!ml/models/labels_dynamic.json
!ml/models/dynamic_metadata.json
!ml/models/dynamic_manifest.json
!ml/models/dynamic_training_history.json
!ml/models/dynamic_evaluation_report.json
# Model C (ISL) side-cars. isl_model.keras itself stays ignored.
!ml/models/labels_isl.json
!ml/models/isl_metadata.json
!ml/models/isl_dataset_manifest.json
!ml/models/isl_training_history.json
!ml/models/isl_evaluation_report.json

# --- MediaPipe assets -----------------------------------------------------
# Downloaded by scripts/setup.sh from Google's model repository.
frontend/public/models/*
!frontend/public/models/.gitkeep

# --- SQLite fallback database ---------------------------------------------
*.db
*.sqlite3

# --- OS / editor noise ----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Bug 5 screenshot comparison output (regenerated on demand)
frontend/screenshots*/

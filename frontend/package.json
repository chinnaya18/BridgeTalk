{
  "name": "bridgetalk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BridgeTalk client \u2014 React 18 + Vite + Tailwind. Runs MediaPipe HandLandmarker in the browser and streams landmarks (never video) to the FastAPI backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "compare:profiles": "node scripts/compare-profiles.mjs",
    "compare:profiles:offline": "node scripts/compare-profiles.mjs --block-fonts",
    "dev:lan": "../scripts/set-lan-ip.sh || true; BRIDGETALK_LAN=1 VITE_API_BASE_URL= VITE_WS_BASE_URL= vite",
    "set-ip": "../scripts/set-lan-ip.sh"
  },
  "dependencies": {
    "@fontsource/roboto": "5.1.0",
    "@mediapipe/tasks-vision": "0.10.18",
    "material-symbols": "0.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "vite": "7.3.6",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}

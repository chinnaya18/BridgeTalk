# ============================================================================
# BridgeTalk — environment configuration TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. This template must never contain real secrets.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Primary connection string used by SQLAlchemy (backend/app/database.py).
# MySQL 8.x / 9.x via PyMySQL:
DATABASE_URL=mysql+pymysql://bridgetalk:your_password_here@localhost:3306/bridgetalk

# For a quick demo with zero database setup, swap the line above for SQLite.
# This is the documented one-line fallback — nothing else in the code changes:
# DATABASE_URL=sqlite:///./bridgetalk.db

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Server / CORS
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API and open WebSockets.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Testing with two devices (development only) ---------------------------
# To join from a second laptop or phone on the same Wi-Fi, run the frontend
# with `npm run dev:lan` and add that machine's HTTPS origin here. Find the
# address Vite prints as "Network:", e.g.:
#
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://192.168.1.42:5173
#
# `dev:lan` proxies /api and /ws through Vite, so the second device needs only
# this one address and accepts only one certificate. See the README, "Testing
# with two devices". Do not carry a LAN origin into production.

# ---------------------------------------------------------------------------
# Machine learning / real-time inference
# ---------------------------------------------------------------------------
# Paths are resolved relative to the repository root.
STATIC_MODEL_PATH=ml/models/static_model.keras
DYNAMIC_MODEL_PATH=ml/models/dynamic_model.keras
MODEL_METADATA_PATH=ml/models/metadata.json
LABELS_PATH=ml/models/labels.json
# Model B (word signs). Missing files here are NOT an error: the dynamic model
# is a stretch goal, and a deployment with only Model A is fully supported.
DYNAMIC_METADATA_PATH=ml/models/dynamic_metadata.json
DYNAMIC_LABELS_PATH=ml/models/labels_dynamic.json
# Indian Sign Language alphabet. ISL fingerspells with BOTH hands where ASL
# uses one, so this model takes 126 features rather than 63 — the ASL weights
# are not merely less accurate on ISL, they are the wrong shape. Missing files
# here are not an error; a deployment may ship either alphabet or both.
ISL_MODEL_PATH=ml/models/isl_model.keras
ISL_METADATA_PATH=ml/models/isl_metadata.json
ISL_LABELS_PATH=ml/models/labels_isl.json

# Predictions below this softmax probability are ignored entirely (Section 9.3).
CONFIDENCE_THRESHOLD=0.80
# After a label is emitted, the same label is suppressed for this many ms.
COOLDOWN_MS=1500
# Majority-vote window: accept a label only if it wins MAJORITY_MIN of the last
# MAJORITY_WINDOW frames.
MAJORITY_WINDOW=10
MAJORITY_MIN=7
# Frames of `nothing` that close the current word.
NEUTRAL_RESET_FRAMES=8
# Rolling buffer length for the dynamic (LSTM) model.
SEQUENCE_LENGTH=30

# --- Dynamic (word-sign) mode ----------------------------------------------
# These are separate from the values above because the two modes behave
# differently, not because tuning was fun:
#   * a lower threshold — 20 word classes trained on ~20 clips each produce
#     much flatter softmax output than 28 letter classes trained on thousands,
#     so reusing 0.80 would reject essentially everything;
#   * a longer cooldown — a word sign takes one to two seconds to perform, so
#     a 1.5s debounce could fire twice inside a single sign;
#   * a smaller vote window — successive dynamic predictions come from windows
#     overlapping by 29 frames out of 30, so they are nearly the same evidence
#     counted again rather than independent confirmation.
DYNAMIC_CONFIDENCE_THRESHOLD=0.70
DYNAMIC_COOLDOWN_MS=2500
DYNAMIC_MAJORITY_WINDOW=5
DYNAMIC_MAJORITY_MIN=3
# Classify every Nth frame rather than every frame.
DYNAMIC_STRIDE=3
# A window with less hand than this is not classified at all — it matches the
# threshold extraction used when deciding which training clips were usable.
DYNAMIC_MIN_DETECTION_RATE=0.30
# Consecutive hand-free frames that clear the SMOOTHER's debounce, so a word
# can be repeated immediately after a pause.
DYNAMIC_RESET_FRAMES=8
# Consecutive hand-free frames that clear the sequence BUFFER. Kept as long as
# the window itself, which makes it nearly a no-op — the buffer already ages
# frames out. It used to be 8, and that was measurably harmful: clearing the
# buffer forces a full 30-frame refill, exactly one sign's length, so the sign
# right after any pause was missed. Raising it cut continuous word error rate
# from 23.3% to 17.5%.
DYNAMIC_BUFFER_RESET_FRAMES=30

# ---------------------------------------------------------------------------
# Frontend (Vite exposes only variables prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# --- WebRTC ICE servers ----------------------------------------------------
# Comma-separated. STUN alone is enough when both peers can reach each other
# directly, which is the case for two laptops on one Wi-Fi network. It is NOT
# enough on symmetric NAT or most corporate/mobile networks — those need TURN,
# which relays the media.
#
# Leave the TURN values empty for local use. Filling them in is the only change
# needed to deploy behind a TURN server; no code change.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
